{
  "name": "anhanga-viagens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215",
  "scripts": {
    "cms:proxy": "decap-server",
    "generate:blog-manifest": "tsx scripts/generate-blog-manifest.ts",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "dev": "pnpm generate:blog-manifest && pnpm generate:sitemap && vite",
    "build": "pnpm generate:blog-manifest && pnpm generate:sitemap && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && gh-pages -d dist",
    "typecheck": "pnpm generate:blog-manifest && pnpm generate:sitemap && tsc --noEmit",
    "test:regression": "pnpm generate:blog-manifest && pnpm generate:sitemap && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:update-snapshots": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:size": "bundlesize --config bundlesize.config.json",
    "prepare": "node scripts/install-hooks.mjs",
    "reviews:fetch": "tsx scripts/fetch-google-reviews.ts",
    "update:dates": "node scripts/update-post-dates.mjs --all",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/cloudflare": "^10.54.0",
    "@sentry/react": "^10.53.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/redis": "^1.38.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.40.0",
    "globe.gl": "^2.46.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "web-haptics": "^0.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "bundlesize2": "^0.0.35",
    "decap-server": "3.7.0",
    "gh-pages": "^6.1.1",
    "gray-matter": "^4.0.3",
    "react-doctor": "^0.2.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "turndown": "^7.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "glob": "^13.0.6",
    "minimatch": "^10.2.2",
    "qs": "^6.15.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "rimraf": "^6.1.3",
      "glob": "^13.0.6",
      "minimatch": "^10.2.2",
      "qs": "^6.15.2"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
