{
  "name": "anhanga-viagens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "cms:proxy": "decap-server",
    "generate:blog-manifest": "tsx scripts/generate-blog-manifest.ts",
    "dev": "pnpm generate:blog-manifest && vite",
    "build": "pnpm generate:blog-manifest && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "pnpm build && gh-pages -d dist",
    "typecheck": "pnpm generate:blog-manifest && tsc --noEmit",
    "test:regression": "pnpm generate:blog-manifest && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:update-snapshots": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "prepare": "node scripts/install-hooks.mjs",
    "update:dates": "node scripts/update-post-dates.mjs --all"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@keystatic/core": "^0.5.50",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "dompurify": "^3.4.0",
    "framer-motion": "^12.35.1",
    "leaflet": "1.9.4",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/dompurify": "^3.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.5",
    "@types/turndown": "^5.0.6",
    "decap-server": "3.7.0",
    "gh-pages": "^6.1.1",
    "gray-matter": "^4.0.3",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  },
  "overrides": {
    "rimraf": "^6.1.3",
    "glob": "^13.0.6",
    "minimatch": "^10.2.2"
  },
  "pnpm": {
    "overrides": {
      "rimraf": "^6.1.3",
      "glob": "^13.0.6",
      "minimatch": "^10.2.2"
    }
  },
  "engines": {
    "node": "24.x"
  }
}
