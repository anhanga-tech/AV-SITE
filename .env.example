# =============================================================================
# REQUIRED - Google Gemini AI
# =============================================================================
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_api_aqui

# Optional: Specify Gemini model (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Route Gemini through Cloudflare AI Gateway for usage monitoring.
# Keep disabled until the Cloudflare gateway and token are configured.
# AI_GATEWAY_ENABLED=false
# CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
# CLOUDFLARE_AI_GATEWAY_ID=default
# CLOUDFLARE_AI_GATEWAY_TOKEN=seu_token_com_permissao_run

# Optional: Enable debug-level server logs.
DEBUG=

# =============================================================================
# OPTIONAL - Error Tracking (Sentry)
# =============================================================================
# Server-side DSN for Cloudflare Pages Functions. This stays server-only.
SENTRY_DSN=

# Browser DSN for React/Vite. VITE_ variables are exposed in the client bundle.
VITE_SENTRY_DSN=

# =============================================================================
# REQUIRED - HubSpot CRM (para captura de leads via chatbot)
# =============================================================================
HUBSPOT_TOKEN=seu_token_do_app_privado
HUBSPOT_DEAL_PIPELINE_ID=id_do_pipeline_deals
HUBSPOT_DEAL_STAGE_ID=id_do_stage_deals

# OPTIONAL - Property name for BANT summary on Deal (default: bant_summary)
# HUBSPOT_DEAL_BANT_PROPERTY=bant_summary

# OPTIONAL - Contact property to store unmapped tracking JSON
# HUBSPOT_CONTACT_TRACKING_FALLBACK_PROPERTY=tracking_payload_json

# OPTIONAL - Static HubSpot list ID for Lollapalooza waitlist contacts
# HUBSPOT_LOLLAPALOOZA_LIST_ID=123

# =============================================================================
# OPTIONAL - Deployment Configuration
# =============================================================================
# Base path for GitHub Pages deployment (e.g., /repo-name/)
# VITE_BASE_PATH=/

# =============================================================================
# OPTIONAL - Media CDN Configuration
# =============================================================================
# Primary media origin for Cloudflare R2 custom domain
# The app defaults to https://media.anhanga.tur.br if this is omitted.
# VITE_MEDIA_BASE_URL=https://media.anhanga.tur.br

# Cloudflare zone that serves image transformations through /cdn-cgi/image/...
# For R2 assets, prefer the media host itself.
# Only used when VITE_MEDIA_ENABLE_TRANSFORMS=true.
# VITE_MEDIA_TRANSFORM_ZONE_URL=https://media.anhanga.tur.br

# Opt in to Cloudflare image transformations after confirming /cdn-cgi/image
# is active for the selected zone. The default keeps direct R2 asset URLs.
# VITE_MEDIA_ENABLE_TRANSFORMS=true

# Legacy alias still supported by the app, but prefer VITE_MEDIA_BASE_URL.
# VITE_MEDIA_CDN_URL=

# =============================================================================
# OPTIONAL - Security Configuration
# =============================================================================
# Allowed origin for CORS (default: https://www.anhanga.tur.br)
# Override this in development/staging environments as needed
# ALLOWED_ORIGIN=https://www.anhanga.tur.br

# Optional: enable verbose debug logs from the shared logger.
DEBUG=false

# =============================================================================
# REQUIRED (prod) - n8n Webhook Secret (para purchase-dispatch)
# =============================================================================
# Segredo compartilhado entre o n8n e o endpoint /api/purchase-dispatch.
# Deve ser igual ao valor configurado no workflow "HubSpot Closed Won -> Purchase Dispatch".
# Gere com: openssl rand -hex 32
N8N_WEBHOOK_SECRET=seu_segredo_aqui

# =============================================================================
# REQUIRED (prod) - n8n Webhook de contato rápido
# =============================================================================
# Webhook que recebe submissões do formulário de contato rápido (CTAs do site).
# Nunca use VITE_ — nunca deve ser exposta ao navegador.
# Autenticação: reutiliza N8N_WEBHOOK_SECRET (já configurado acima).
N8N_SUBMIT_CONTACT_WEBHOOK_URL=https://seu-n8n.com/webhook/contact-form

# =============================================================================
# REQUIRED (prod) - Rate Limiting (Upstash Redis)
# =============================================================================
# Cloudflare Pages Functions run in isolated V8 contexts — module-level state
# resets on every request. Without Redis, rate limiting is non-functional in
# production and the Gemini proxy (/api/generate) is unprotected against abuse.
# Get your credentials at: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# =============================================================================
# REQUIRED (prod) - Decap CMS — GitHub OAuth (para login em /admin)
# =============================================================================
# 1. Crie um OAuth App em: https://github.com/settings/applications/new
#    - Application name: Anhangá Viagens CMS
#    - Homepage URL: https://www.anhanga.tur.br
#    - Authorization callback URL: https://www.anhanga.tur.br/api/auth/callback
# 2. Adicione as 2 variáveis abaixo no Vercel Dashboard (Production + Preview + Development)
GITHUB_CLIENT_ID=seu_github_oauth_client_id
GITHUB_CLIENT_SECRET=seu_github_oauth_client_secret

# =============================================================================
# REQUIRED (prod) - NPS pós-viagem
# =============================================================================
# URL do webhook n8n que recebe as respostas do formulário de NPS.
# Nunca use VITE_ nesta variável — ela nunca deve ser exposta ao navegador.
NPS_WEBHOOK_URL=https://seu-n8n.com/webhook/nps-pos-viagem

# =============================================================================
# OPTIONAL - Google Reviews (Outscraper + Cloudflare R2 via wrangler)
# =============================================================================
# OUTSCRAPER_API_KEY=your_outscraper_api_key
# GOOGLE_PLACE_ID=your_google_place_id
# R2_BUCKET_NAME=your_bucket_name
# R2_CDN_BASE_URL=https://media.anhanga.tur.br
