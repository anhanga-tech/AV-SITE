# =============================================================================
# REQUIRED - Google Gemini AI
# =============================================================================
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_api_aqui

# Optional: Specify Gemini model (default: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Route Gemini through Cloudflare AI Gateway for usage monitoring.
# Keep disabled until the Cloudflare gateway and token are configured.
# AI_GATEWAY_ENABLED=false
# CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
# CLOUDFLARE_AI_GATEWAY_ID=default
# CLOUDFLARE_AI_GATEWAY_TOKEN=seu_token_com_permissao_run

# Optional: Use a Gemini key stored in the AI Gateway (BYOK / Provider Keys).
# Set to the key alias configured in the gateway dashboard. When set (and the
# gateway is enabled), GEMINI_API_KEY becomes optional and is never sent upstream.
# AI_GATEWAY_BYOK_ALIAS=chatbot

# Optional: Enable debug-level server logs.
DEBUG=

# =============================================================================
# OPTIONAL - Error Tracking (Sentry)
# =============================================================================
# Server-side DSN for Cloudflare Pages Functions. This stays server-only.
SENTRY_DSN=

# Browser DSN for React/Vite. VITE_ variables are exposed in the client bundle.
VITE_SENTRY_DSN=

# =============================================================================
# REQUIRED (prod) - Odoo (CRM ativo) — intake dos formulários
# =============================================================================
# Os 4 formulários de lead (chatbot/corporativo, contato, quiz, waitlist) postam
# direto no Odoo via External API JSON-RPC (server-side). A API key entra no lugar
# da senha (Odoo: avatar → Minha conta → Segurança da conta → Nova chave de API).
# Nunca use VITE_ — estas variáveis nunca podem ser expostas ao navegador.
ODOO_URL=https://anhanga.odoo.com
ODOO_DB=anhanga
ODOO_LOGIN=contato@anhanga.tur.br
ODOO_API_KEY=sua_api_key_do_odoo

# =============================================================================
# HubSpot e Salesforce foram descontinuados (set/2026). O CRM ativo é o Odoo (acima).
# =============================================================================

# =============================================================================
# OPTIONAL - Deployment Configuration
# =============================================================================
# Base path for GitHub Pages deployment (e.g., /repo-name/)
# VITE_BASE_PATH=/

# =============================================================================
# OPTIONAL - Media CDN Configuration
# =============================================================================
# Primary media origin for Cloudflare R2 custom domain
# The app defaults to https://media.anhanga.tur.br if this is omitted.
# VITE_MEDIA_BASE_URL=https://media.anhanga.tur.br

# Cloudflare zone that serves image transformations through /cdn-cgi/image/...
# For R2 assets, prefer the media host itself.
# Only used when VITE_MEDIA_ENABLE_TRANSFORMS=true.
# VITE_MEDIA_TRANSFORM_ZONE_URL=https://media.anhanga.tur.br

# Opt in to Cloudflare image transformations after confirming /cdn-cgi/image
# is active for the selected zone. The default keeps direct R2 asset URLs.
# VITE_MEDIA_ENABLE_TRANSFORMS=true

# Legacy alias still supported by the app, but prefer VITE_MEDIA_BASE_URL.
# VITE_MEDIA_CDN_URL=

# =============================================================================
# OPTIONAL - Security Configuration
# =============================================================================
# Allowed origin for CORS (default: https://www.anhanga.tur.br)
# Override this in development/staging environments as needed
# ALLOWED_ORIGIN=https://www.anhanga.tur.br

# Opt-in: trust http://localhost:3000 for the Decap CMS OAuth handshake
# (lib/auth-origin.ts). Off by default everywhere, including local dev —
# only set this locally when you actually need to test the OAuth flow
# against /admin. NEVER set this in production.
# ENABLE_DEV_OAUTH_ORIGIN=true

# Optional: enable verbose debug logs from the shared logger.
DEBUG=false

# =============================================================================
# REQUIRED (prod) - n8n Webhook Secret (para purchase-dispatch)
# =============================================================================
# Segredo compartilhado entre o n8n e o endpoint /api/purchase-dispatch.
# Ver docs/product/odoo-ads-conversion-decision.md para o gatilho atual (o
# workflow original era acionado por deals HubSpot, hoje descontinuado).
# Gere com: openssl rand -hex 32
N8N_WEBHOOK_SECRET=seu_segredo_aqui

# =============================================================================
# OPTIONAL - Conversões offline (Odoo → Google/Meta)
# =============================================================================
# Ver docs/product/odoo-ads-conversion-decision.md e docs/ops/conversion-dispatch-runbook.md
PURCHASE_DISPATCH_ENABLED=     # 'false' desliga /api/purchase-dispatch (kill switch; default: ligado)
ODOO_CONVERSION_FIELDS_ENABLED=  # 'true' só depois dos campos x_gclid/x_fbclid/... existirem no Odoo

# =============================================================================
# REQUIRED (prod) - NPS Invitation Secret (para /api/submit-nps)
# =============================================================================
# HMAC-SHA256 key usada para assinar/verificar o link de convite de NPS
# (lib/nps-invite.ts). O link (?token=...) é gerado pelo fluxo operacional de
# pós-venda (ver docs/ops/nps-invite.md) e vale por 30 dias, uso único.
# Gere com: openssl rand -hex 32
NPS_INVITE_SECRET=seu_segredo_aqui

# =============================================================================
# OPTIONAL - Meta Conversions API (CAPI) — eventos Lead / Purchase server-side
# =============================================================================
# Usado por /api/purchase-dispatch (lib/conversions/meta.ts) para enviar eventos
# standard à Graph API com deduplicação por event_id (mesmo id do Pixel no browser).
# Sem essas variáveis o envio server-side é ignorado (fail-safe — sem double-count).
# META_PIXEL_ID=seu_pixel_id
# META_ACCESS_TOKEN=seu_access_token            # System User token com ads_management
# META_TEST_EVENT_CODE=                         # Opcional: code do Events Manager (Test Events)

# =============================================================================
# LEGADO - n8n Webhook de contato rápido (não usar — contato agora vai pro Odoo)
# =============================================================================
# Desde o cut-over para o Odoo, o formulário de contato rápido posta direto no
# Odoo (como os demais leads). Esta variável não é mais lida pelos handlers.
# N8N_SUBMIT_CONTACT_WEBHOOK_URL=https://seu-n8n.com/webhook/contact-form

# =============================================================================
# REQUIRED (prod) - Rate Limiting (Upstash Redis)
# =============================================================================
# Cloudflare Pages Functions run in isolated V8 contexts — module-level state
# resets on every request. Without Redis, rate limiting is non-functional in
# production and the Gemini proxy (/api/generate) is unprotected against abuse.
# Get your credentials at: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_rest_token

# =============================================================================
# REQUIRED (prod) - Decap CMS — GitHub OAuth (para login em /admin)
# =============================================================================
# 1. Crie um OAuth App em: https://github.com/settings/applications/new
#    - Application name: Anhangá Viagens CMS
#    - Homepage URL: https://www.anhanga.tur.br
#    - Authorization callback URL: https://www.anhanga.tur.br/api/auth/callback
# 2. Adicione as 2 variáveis abaixo no dashboard do Cloudflare Pages (Settings → Environment Variables)
GITHUB_CLIENT_ID=seu_github_oauth_client_id
GITHUB_CLIENT_SECRET=seu_github_oauth_client_secret

# =============================================================================
# LEGADO - n8n Webhook de NPS (não usar — NPS agora vai pro Odoo)
# =============================================================================
# Desde o cut-over para o Odoo, o formulário de NPS pós-viagem posta direto no
# Odoo (res.partner.x_nps_score), igual aos demais formulários. Esta variável
# não é mais lida pelos handlers. Usa ODOO_URL/ODOO_DB/ODOO_LOGIN/ODOO_API_KEY
# acima.
# NPS_WEBHOOK_URL=https://seu-n8n.com/webhook/nps-pos-viagem

# =============================================================================
# OPTIONAL - Google Reviews (Outscraper + Cloudflare R2 API)
# =============================================================================
# OUTSCRAPER_API_KEY=your_outscraper_api_key
# GOOGLE_PLACE_ID=your_google_place_id
# R2_BUCKET_NAME=your_bucket_name
# R2_CDN_BASE_URL=https://media.anhanga.tur.br
# CLOUDFLARE_API_TOKEN=your_r2_edit_token  # Token with R2 Storage: Edit permission
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id  # Also used by AI Gateway above

# OPTIONAL - R2 batch image optimizer (scripts/optimize-r2-images.ts)
# S3-compatible credentials. Create an R2 API token with "Object Read & Write".
# R2_ACCOUNT_ID=your_cloudflare_account_id            # the <id>.r2.cloudflarestorage.com host
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
