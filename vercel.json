{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "beto.anhanga.tur.br"
        }
      ],
      "destination": "https://www.anhanga.tur.br/beto-carrero",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "https://blog.anhanga.tur.br",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "https://blog.anhanga.tur.br/:slug*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
