{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anhanga.tur.br"
        }
      ],
      "destination": "https://www.anhanga.tur.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "beto.anhanga.tur.br"
        }
      ],
      "destination": "https://www.anhanga.tur.br/beto-carrero",
      "permanent": true
    },
    {
      "source": "/lollapalooza-2026",
      "destination": "/lollapalooza",
      "permanent": true
    },
    {
      "source": "/lollapalooza-2026/",
      "destination": "/lollapalooza",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/markdown"
        }
      ],
      "destination": "/api/markdown?path=/$1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api/api-catalog"
    },
    {
      "source": "/.well-known/api-docs",
      "destination": "/api/api-docs"
    },
    {
      "source": "/.well-known/openapi.json",
      "destination": "/api/openapi"
    },
    {
      "source": "/api/keystatic/:path*",
      "destination": "/api/keystatic/[...params]"
    },
    {
      "source": "/keystatic/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\"; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
