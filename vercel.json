{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "anhanga.tur.br"
        }
      ],
      "destination": "https://www.anhanga.tur.br/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "beto.anhanga.tur.br"
        }
      ],
      "destination": "https://www.anhanga.tur.br/beto-carrero",
      "permanent": true
    },
    {
      "source": "/lollapalooza-2026",
      "destination": "/lollapalooza",
      "permanent": true
    },
    {
      "source": "/lollapalooza-2026/",
      "destination": "/lollapalooza",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/keystatic/:path*",
      "destination": "/api/keystatic/[...params]"
    },
    {
      "source": "/keystatic/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
